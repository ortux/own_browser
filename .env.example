# Zyphora environment configuration
#
# Copy to `.env` in the repository root and fill in the values you need.
# Every variable here is OPTIONAL — the browser runs without any of them,
# with the feature in question degrading gracefully.
#
# `.env` is gitignored. Never commit real keys or proxy credentials.

# ── New Tab background images (Pexels) ───────────────────────────────────────
# Without a key the New Tab page falls back to a plain themed background and
# logs "[Pexels] No API key configured".
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Sync / account backend ───────────────────────────────────────────────────
# Defaults to https://api-zyphora.obliqllc.xyz when unset. Point this at a
# local backend during development, e.g. http://localhost:8080
# VITE_API_BASE_URL is read by the renderer bundle; API_BASE_URL by the main
# process (used for the OAuth navigation allowlist).
VITE_API_BASE_URL=
API_BASE_URL=

# ── Optional proxy pool ──────────────────────────────────────────────────────
# Comma-separated list of ip:port:username:password entries. The Settings
# proxy toggle picks one at random and verifies it before use. When unset the
# toggle reports "No proxy configured" instead of silently doing nothing.
ZYPHORA_PROXY_LIST=

# ── DNS-over-HTTPS mode ──────────────────────────────────────────────────────
# "automatic" (default) prefers AdGuard DoH but falls back to system DNS if it
# is unreachable. Set to "secure" for fail-closed DNS — stronger privacy, but
# every page fails to resolve if the DoH endpoint is blocked.
# This can also be toggled in Settings → Privacy ("Strict private DNS"); the
# environment variable, when set, overrides that choice.
ZYPHORA_DNS_MODE=
