{
  "name": "own-browser",
  "version": "0.0.1",
  "description": "A secure, privacy-focused desktop web browser built with Electron, React, and Go",
  "type": "module",
  "main": "./dist/main/index.js",
  "author": "Browser Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron dist/main/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@electron/fuses": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "eslint": "^8.50.0",
    "playwright": "^1.55.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "cross-fetch": "^4.1.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.372.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sql.js": "^1.14.2",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.you.ownbrowser",
    "productName": "Zyphora",
    "copyright": "Copyright © 2026",
    "npmRebuild": false,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "icon": "public/icon.png",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "executableName": "zyphora",
      "maintainer": "Suprit Pahari <supritpahari123@gmail.com>",
      "description": "A secure, privacy-focused desktop web browser built with Electron and React",
      "synopsis": "Privacy-focused desktop web browser",
      "desktop": {
        "entry": {
          "GenericName": "Web Browser",
          "Comment": "Browse the web without being tracked",
          "Keywords": "Internet;WWW;Browser;Web;Explorer;Privacy;"
        }
      },
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ]
    },
    "afterPack": "./scripts/fuses.cjs",
    "publish": {
      "provider": "github",
      "owner": "supritpahari",
      "repo": "own_browser"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
